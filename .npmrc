# parlor — the only .npmrc in the tree, and it is one line.
#
# `engine-strict` turns `engines.node` in package.json from a warning into a
# gate. Without it npm prints EBADENGINE and installs anyway, which makes the
# runtime pin a suggestion: verified on this machine, where the same `npm ci`
# runs on whatever Node the PATH happens to carry — 22.22.2 inside this repo
# because mise.toml is read, 22.12.0 a directory away because nothing says
# otherwise. With it, `npm ci` exits nonzero on a Node that does not match, so
# the pin is the pin of record and a drifting runner is a red build rather than
# a suite that quietly passed on a different runtime.
#
# The exact version lives in package.json. mise.toml and the CI workflow mirror
# it, and `bash tests/validate-ci.sh` fails when the three disagree — so this is
# one number in four places with a gate on the agreement, not four pins.
engine-strict=true
