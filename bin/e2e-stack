#!/usr/bin/env bash
# The whole-stack lifecycle for the end-to-end suite: build, up, wait, down.
#
#   bin/e2e-stack build              build the image this tier tests
#   bin/e2e-stack publish-siblings   build identity + gateway + oauth-stub, push to the registry
#   bin/e2e-stack up                 build, publish/pull siblings, migrate, start, wait
#   bin/e2e-stack wait               wait for /readyz on an already-running stack
#   bin/e2e-stack host-port <service>   the published host port, on stdout
#   bin/e2e-stack verify-sibling-images [<svc>]   which ref an image was built from
#   bin/e2e-stack logs               print the stack's logs
#   bin/e2e-stack ps                 what is running
#   bin/e2e-stack down               stop it and delete its volumes
#
# `bin/e2e` drives this; a developer can drive it directly when a test failed
# and the stack is still up, which is the point of leaving it up on failure.
#
# ---------------------------------------------------------------------------
# WHERE THE SIBLING IMAGES COME FROM — read this before "simplifying" a build
# ---------------------------------------------------------------------------
# This repository builds exactly one image: `parlor`'s, the service under test.
# `identity`, `gateway` and `oauth-stub` are CONSUMED as published artifacts by
# tag, out of the registry e2e/docker-compose.yml declares. That is the change
# this script was rewritten for, and the rule that follows from it is the one
# that is easy to break by accident:
#
#   * a `docker compose build` with no arguments now builds ONE image, not three.
#     That is not a bug and not a missing loop. Rebuilding the siblings here is
#     what made this tier able to pass while testing an image nothing else in
#     the fleet had ever run.
#   * `E2E_BUILD_SIBLINGS=1` is the ONE documented way back to a working-tree
#     build, and it layers e2e/docker-compose.siblings.yml rather than
#     re-adding the stanzas to the main file. See that file for why it is one
#     flag and not two defaults.
#   * The sibling checkouts are therefore REQUIRED only in that mode. The
#     preflight used to fail without them unconditionally, which was correct
#     while every image was built here and is wrong now.
#
# ---------------------------------------------------------------------------
# THE FOUR RULES THIS SCRIPT EXISTS TO ENFORCE
# ---------------------------------------------------------------------------
#
# 1. DETERMINISTIC BRING-UP OR A LOUD FAILURE. Every long command is wrapped in
#    `timeout` and prints a checkpoint before it starts, so a ten-minute silent
#    tool call is a series of sentences instead. When the stack does not come
#    up, the failing container's logs are printed *here*, before the exit: a
#    harness that says "stack did not come up" and stops has cost the next
#    person an hour, and this is the one place that hour was being spent.
#
# 2. READINESS, NOT SLEEPING. Nothing in this file sleeps a fixed number of
#    seconds to hope a service is up. Every wait is a bounded poll on a
#    `/readyz` — the endpoint every cafaye service already exposes and the
#    platform contract fixes. The slowest container in the stack is the slowest
#    thing in the stack, and a fixed sleep is either too short (a flake) or too
#    long (a tax on every run).
#
# 3. A BOUNDED BUDGET ON EVERY WAIT. Each wait has a deadline and, on expiry,
#    prints what it was waiting for and why. An unbounded poll against a
#    dependency that will never answer is how a CI job runs for six hours and
#    then reports a timeout with no information in it.
#
# 4. NO SLEEP IS EVER THE ANSWER TO A MISSING SIGNAL. A service with no
#    `/readyz` is a finding, printed as one. The one service here that cannot
#    be probed from inside its own container — identity, whose distroless image
#    has no HTTP client — is documented in e2e/docker-compose.yml, and is
#    probed from here instead.
#
# ---------------------------------------------------------------------------
# WHAT IS NOT IN THIS FILE
# ---------------------------------------------------------------------------
# The topology, the image pins, the port block and the healthchecks. They are in
# e2e/docker-compose.yml, next to the reasoning for each. This file is the
# machine that drives that document, and it reads the ports and the readiness
# paths out of it rather than restating them, because a second copy of a port
# number is a second thing to keep true.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
COMPOSE_FILE="$ROOT/e2e/docker-compose.yml"
# The hatch. Layered ONLY when E2E_BUILD_SIBLINGS is 1 — it is an array rather
# than an extra `--file` that is always passed, because a file that is always
# layered is a second default and the whole point is that there is one.
SIBLINGS_OVERRIDE="$ROOT/e2e/docker-compose.siblings.yml"
PROJECT="${E2E_STACK_NAME:-parlor-e2e}"

# The services this tier consumes rather than builds, and the tag prefix
# they share. Listed once because four places need the same list and a list
# that can drift is a list where a service silently stops being published.
#
# `oauth-stub` joined the list with parlor-e2e-social-01, when the social sign-in
# path stopped being untestable here: until then there was no way to run it
# end to end at all, because the only provider this deployment could have been
# pointed at was a fake carried inside this repository. `github.com/cafaye/
# oauth-stub` is a published, versioned repository and this tier consumes it by
# tag like any other sibling. It is a TEST DOUBLE and it is still a sibling:
# being a fake is a statement about what it answers, not about whether it has a
# deploy path, a version anybody depends on, or a suite that ought to be the one
# that runs.
#
# `parlor` has no `pantry`, unlike `site`'s list. That is a fact about this
# stack's topology rather than a decision this array makes: nothing in
# e2e/docker-compose.yml is pantry, so a name here would be a sibling whose image
# is published and never dialled.
#
# ADDING A SIBLING MEANS ADDING IT HERE AND NOWHERE ELSE in this file except for
# the two things it cannot be built or pinned without (`publish_siblings`'s
# `case`, and `sibling_default_ref` when it does not track `master`).
# Everything else — the readiness order, the resolver, the tag, the provenance
# check — iterates this array, so a name added here is published, pulled and
# checked by all of them without a second edit.
SIBLING_SERVICES=(identity gateway oauth-stub)
SIBLING_TAG_PREFIX="${SIBLING_TAG_PREFIX:-cafaye}"
SIBLING_TAG_SUFFIX=e2e

# The registry the siblings are published to and pulled from. The default is
# the loopback address the compose file's `registry` service publishes to; point
# E2E_REGISTRY at anything else and the whole document follows it, because no
# other file in this tier names the registry.
REGISTRY="${E2E_REGISTRY:-localhost:16010}"

# One flag, read once, and validated once. Anything but 0/1 is a typo rather
# than a setting, and `E2E_BUILD_SIBLINGS=yes` silently meaning "off" is exactly
# the kind of quiet default this change exists to remove.
BUILD_SIBLINGS=0
case "${E2E_BUILD_SIBLINGS:-0}" in
  1) BUILD_SIBLINGS=1 ;;
  0|"") ;;
  *) printf '[e2e] FAIL: E2E_BUILD_SIBLINGS is "%s"; it is 1 (build the siblings from their checkouts) or 0 (pull the published artifacts), and nothing else.\n' "${E2E_BUILD_SIBLINGS:-}" >&2; exit 1 ;;
esac

# The sibling image tag for a service, on stdout and nothing else.
sibling_tag() { printf '%s/%s:%s' "$SIBLING_TAG_PREFIX" "$1" "$SIBLING_TAG_SUFFIX"; }

# ---------------------------------------------------------------------------
# WHICH SOURCE A SIBLING IMAGE IS BUILT FROM, and why that is a variable
# ---------------------------------------------------------------------------
# A published sibling artifact is built from a NAMED REF of that sibling's
# repository, and nothing else. Not from the working tree, not from whatever
# HEAD somebody left in the checkout, and not from whatever directory happens to
# be sitting next to this one.
#
# This is not a preference. It is the defect cafaye/site measured on the image
# rather than argued from the source (a named ref, stamped into the artifact and
# checked by `verify-sibling-images`):
#
#   $ curl -s http://localhost:16081/v1/pantry/v1/services
#   HTTP 401 — "a bearer token is required"
#
# site's `e2e/docker-compose.siblings.yml` built gateway with `context:
# ../gateway`, and `bin/e2e-stack` runs compose with `--project-directory` at the
# repository root, so `../gateway` is the sibling checkout — which on that machine
# was parked on another agent's unmerged branch. That tree had no
# `public?: boolean`, so the image had no `isPublicRoute` in it at all:
#
#   docker cp <container>:/app/src/routes/table.ts /tmp/t.ts
#   grep -c isPublicRoute /tmp/t.ts     # 0
#
# The stack came up green. Every readiness probe passed. The one request the
# whole tier exists to prove answered 401, because the running gateway did not
# understand the route table it was configured with. **A harness that cannot tell
# which source it built is not a gate** — it is a script that reports on whatever
# was lying next to it.
#
# ---------------------------------------------------------------------------
# WHY THE REF IS PER-SIBLING AND WHY IT MOSTLY DEFAULTS TO `master`
# ---------------------------------------------------------------------------
# One variable per sibling rather than one for all of them, because the
# repositories move at different rates and a single global ref would make
# building an in-flight oauth-stub against gateway's master a second command. The
# name is `E2E_SIBLING_REF_<SERVICE>`, uppercased, so nothing has to be added to
# this file when a sibling is: a sibling added to SIBLING_SERVICES gets a ref from
# the same rule without a second edit.
#
# `master` is the default because it is the only answer that is right on a clean
# checkout, which is the case `bin/e2e` has to work in with no manual steps. It is
# NOT the only ref that may be named: a developer testing an unmerged sibling
# branch says so in the environment, and the ref they named is recorded in the
# image's labels and printed in the log, so the run says which branch it was.
SIBLING_DEFAULT_REF=master

# ---------------------------------------------------------------------------
# THE ONE SIBLING THAT DOES NOT TRACK `master`, and why this is a `case`
# ---------------------------------------------------------------------------
# `oauth-stub` is pinned to `v0.1.0` and must not fall through to the
# `SIBLING_DEFAULT_REF` above. The reason is specific to what it is: a TEST
# DOUBLE is a dependency of this tier's ASSERTIONS, not of the product, and a
# double that moves under the harness changes the meaning of a green run without
# changing any line of this repository. If `oauth-stub`'s `/github/user` starts
# answering a verified address inline, `social.e2e.spec.ts` — whose second test
# exists precisely to exercise the `/user/emails` fallback that a null address
# forces — stops exercising it and still passes. The suite reports coverage of a
# path the deployment no longer takes. A test double that moves is a harness
# whose result changes for reasons nobody can read.
#
# `identity` and `gateway` are the opposite case and are deliberately NOT pinned:
# they are the product this tier exists to test, they are released continuously,
# and pinning them to a tag would mean a security fix in either of them could not
# reach the tier until somebody edited this file. **A pin is right for a fixture
# and wrong for a service**, which is why this is per-sibling rather than a global
# "everything gets pinned" rule.
#
# WHY A `case` AND NOT AN ASSOCIATIVE ARRAY, because macOS ships bash 3.2 and
# `declare -A` is 4.0 — the same constraint `tests/validate-ci.sh` records at its
# own `breakage_axis`, for the same reason. The alternative was a second parallel
# array (`SIBLING_PINS=(...)`) indexed against `SIBLING_SERVICES`, and it is worse
# than this for a reason that is about failure rather than style: two arrays must
# stay the same length, in the same order, forever, and nothing checks it. A
# sibling added to the front of `SIBLING_SERVICES` would silently take the first
# sibling's pin, and `verify-sibling-images` would then report a perfectly
# confident, completely wrong answer about which source an image came from. A
# `case` matches by NAME, so the failure mode of forgetting is "no pin, falls
# through to the documented default" — which is exactly what the other two
# siblings want and is visible in the log.
#
# It is NOT a second registration list either: a sibling absent from this `case`
# is not missing a line, it is on `master`, and every function that needs a ref
# asks `sibling_ref` rather than reading the pin table.
sibling_default_ref() {
  case "$1" in
    # The published tag, exactly. Bump it when a release lands and say why in the
    # commit; that commit is the only record of which double the assertions were
    # written against.
    oauth-stub) printf '%s' 'v0.1.0' ;;
    # `master`, spelled out rather than falling out of the `case`, so the list of
    # siblings that track the tip is readable here and a future sibling added to
    # SIBLING_SERVICES can copy this arm.
    identity|gateway) printf '%s' "$SIBLING_DEFAULT_REF" ;;
    # Not an error. A new sibling on `master` needs no line here at all (see the
    # comment above); this arm exists so that a MISSPELLED name is loud rather
    # than silent, and so a reader who adds a name here cannot typo the pin.
    *) printf '%s' "$SIBLING_DEFAULT_REF" ;;
  esac
}

# The ref a sibling is published from. Echoed as `<name>=<ref>` on stdout,
# because the log line that attributes an image has to be able to name the thing
# it read the name out of.
#
# PRECEDENCE, and the reason it is in this order: the ENVIRONMENT wins over the
# pin. A pin exists so that the default answer is stable; it is not a lock, and a
# developer testing an unmerged oauth-stub branch names it explicitly and gets
# what they asked for, recorded in the image's labels either way.
sibling_ref() {
  local service=$1 var upper
  upper=$(printf '%s' "$service" | tr '[:lower:]-' '[:upper:]_')
  var="E2E_SIBLING_REF_${upper}"
  printf '%s=%s' "$service" "${!var:-$(sibling_default_ref "$service")}"
}

# Resolve a ref to a commit sha in a sibling's checkout, and FAIL rather than
# guess. Three answers, in order, and the last one is an error:
#
#   <ref>              a branch or tag in the local repository
#   origin/<ref>       a remote branch nobody has fetched — the ordinary case on
#                      a fresh clone, and the one that must not be a silent
#                      fallback to something local
#   error              with the command that fixes it
#
# The error names `git fetch` rather than saying "ref not found", because "ref
# not found" on a machine that has simply not fetched is a sentence that sends
# the reader to the wrong place.
sibling_revision() {
  local service=$1 ref=$2 dir sha
  dir="$ROOT/../$service"
  [ -d "$dir/.git" ] || die "no git checkout of $service at $dir — ../$service is not a repository, so this harness cannot name the source of an image it is about to build or verify"
  if sha=$(git -C "$dir" rev-parse --verify --quiet "${ref}^{commit}" 2>/dev/null); then
    printf '%s' "$sha"
    return 0
  fi
  if sha=$(git -C "$dir" rev-parse --verify --quiet "origin/${ref}^{commit}" 2>/dev/null); then
    printf '%s' "$sha"
    return 0
  fi
  printf '[e2e] FAIL: %s has no ref "%s"\n' "$service" "$ref" >&2
  printf '[e2e] Neither %s nor origin/%s resolves to a commit in %s.\n' "$ref" "$ref" "$dir" >&2
  printf '[e2e] E2E_SIBLING_REF_%s names it; fetch it with:\n' "$(printf '%s' "$service" | tr '[:lower:]-' '[:upper:]_')" >&2
  printf '[e2e]   git -C %s fetch --all\n' "$dir" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# THE BUILD CONTEXT IS THE REF, NOT A DIRECTORY
# ---------------------------------------------------------------------------
# `git archive <sha> | tar -x -C <tmp>` materialises exactly the tracked content
# of one commit, in a temporary directory, and the `docker build` context is that.
# Nothing from anybody's working tree can get into the image, and nothing is
# written into the sibling's repository at all.
#
# `git worktree add --detach` is the more usual answer and was rejected for one
# reason: it registers an entry in the sibling repository's `.git/worktrees/`.
# The siblings are repositories other sessions are actively working in, and
# `../gateway` in particular may be parked on someone's in-flight branch. A build
# that leaves a trace in another session's repository is a build that can collide
# with that session. `git archive` reads and writes nothing outside the temporary
# directory.
#
# The limitation is deliberate and worth stating: an archive cannot carry a git
# submodule or an LFS pointer's contents. None of the three siblings here has
# either (gateway and identity are bun, oauth-stub is go, all three vendor
# nothing), and a sibling that grows one will fail its e2e build loudly at
# `docker build` — which is the right failure, and a better one than a silently
# empty directory.
sibling_export_tree() {
  local service=$1 sha=$2 dir tmp
  dir="$ROOT/../$service"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/cafaye-e2e-${service}-XXXXXX")
  # `tar -x` from a pipe and not `git archive -o`: the pipe has no cleanup if the
  # extraction fails halfway, and a stray tarball in TMPDIR is a small thing to
  # leave behind on a machine with another agent on it.
  if ! git -C "$dir" archive --format=tar "$sha" | tar -x -C "$tmp"; then
    rm -rf "$tmp"
    die "exporting $service at $sha from $dir failed; the build context was not produced"
  fi
  printf '%s' "$tmp"
}

# ---------------------------------------------------------------------------
# THE STAMP, and why it is not an org.opencontainers label
# ---------------------------------------------------------------------------
# Every image this harness publishes carries three labels of its own:
#
#   cafaye.e2e.source     the ref it was built from, verbatim
#   cafaye.e2e.revision   the commit that ref resolved to at build time
#   cafaye.e2e.dirty      "false" — the context was a ref, so it could not be dirty
#
# `docker build --label` sets these on any Dockerfile, which is why they do not
# have to be declared in the siblings' Dockerfiles, and why adding a sibling
# needs no change in four other repositories.
#
# NOT `org.opencontainers.image.revision`, and the reason is measured on this
# fleet's own gateway image rather than guessed:
#
#   $ docker image inspect --format '{{json .Config.Labels}}' \
#       localhost:16010/cafaye/gateway:e2e
#   {"org.opencontainers.image.created":"...","org.opencontainers.image.revision":
#   "700fc117a2fd01ac0201deaa6fa69c5557acb04f","org.opencontainers.image.source":
#   "https://github.com/oven-sh/bun", …}
#
# Those are BUN's labels, inherited through `FROM oven/bun`, and
# `docker/provenance.sh --verify` reads that key and exits 0 on it — a confident
# false answer, printed as provenance, about a bun commit. Writing a real revision
# into that key would make a third-party verification tool assert something about
# our source tree on the strength of a base image's metadata. So this harness keeps
# its attribution in a namespace it owns, and `publish_siblings` continues to
# *print* `--verify` without asserting it (the reasoning for that is in the
# function and has not changed).
sibling_label_args() {
  local service=$1 ref=$2 sha=$3
  printf '%s\n' \
    "--label" "cafaye.e2e.source=$ref" \
    "--label" "cafaye.e2e.revision=$sha" \
    "--label" "cafaye.e2e.dirty=false"
}

# A short sha on stdout, and the full one on failure — a log line wants seven
# characters and an error message wants all forty.
short_sha() { printf '%s' "${1:0:7}"; }

# Budgets. Every one is overridable because a cold run on a laptop and a warm
# run on a CI runner differ by an order of magnitude, and a hard-coded budget
# that is right for one of them is wrong for the other.
# Build parallelism. One image at a time by default, and this is a measured
# setting rather than a cautious one: three toolchains building at once (a Go
# compile, the `bun test` inside gateway's image, and Next/Turbopack) is enough
# RAM to take a laptop's container runtime down, and on the machine this was
# written on it did — OrbStack stopped responding part-way through a cold build
# and the run failed with a socket error naming nothing about the cause. A cold
# run is slower this way and it finishes. Raise it with COMPOSE_PARALLEL_LIMIT
# when there is room for it.
export COMPOSE_PARALLEL_LIMIT="${COMPOSE_PARALLEL_LIMIT:-1}"

BUILD_TIMEOUT="${E2E_BUILD_TIMEOUT:-1800}"   # image builds: three toolchains, cold cache
UP_TIMEOUT="${E2E_UP_TIMEOUT:-420}"          # create + start + health
READY_TIMEOUT="${E2E_READY_TIMEOUT:-180}"    # per-service /readyz poll

# The poll interval is not a sleep in the sense rule 2 forbids: it is the gap
# between two probes of a condition, and the condition is what gates the loop.
POLL_INTERVAL="${E2E_POLL_INTERVAL:-1}"

# The services the harness waits on, in the order it waits for them, and the
# readiness path each one answers. `service:container_port` is the *container*
# side, which the image fixes; the host side is what the compose file publishes
# and is read back out of it below.
#
# Read from the compose file rather than listed here, so adding a service to the
# stack adds it to the wait without a second edit. `docker compose config
# --format json` is the parsed document: a half-parsed YAML read is a worse
# reader than the tool that renders the file.
#
# `oauth-stub` and `oauth-stub-github` ARE here, and both are polled FROM THE
# HOST for the reason identity is: their published image is
# `gcr.io/distroless/static-debian12:nonroot`, which carries no HTTP client and no
# shell, so nothing inside the container can answer a probe. The poll IS the
# readiness signal, which is why leaving them out would be the defect this array's
# own comment above describes — a service that starts and is never waited for,
# while the suite is already driving a browser at its authorize endpoint.
#
# There are TWO ENTRIES for ONE IMAGE, and the array is keyed on service name
# (`host_port` looks a port up by that name), so one entry would be a silent gap.
# Why two instances exist at all is `oauth-stub`'s: it accepts exactly one
# `client_id`, and identity here holds two providers under two different ids, as
# two real providers would be — so one instance cannot serve both and the other
# provider is refused at every authorization.
#
# They go last because nothing in the stack talks to them at BOOT: identity
# dials a provider during a sign-in, and a sign-in is a browser action. Gating
# identity's boot on a fixture would be a false dependency, and it would turn a
# fixture's outage into "identity will not start".
READY_SERVICES=(identity-postgres identity gateway parlor edge oauth-stub oauth-stub-github)

log() { printf '[e2e] %s\n' "$*"; }
die() { printf '[e2e] FAIL: %s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH. $2"
}

# `--project-directory` is the repository root, not `e2e/`. Compose resolves a
# relative `build.context` against the project directory, so without this the
# `../identity` in the compose file means "a directory called identity inside
# the repository" and the build fails with a path error rather than a reason.
# With it, `../identity` is the sibling checkout, which is what the file says it
# is and what the preflight below checks for.
#
# THE FILE LIST IS CONDITIONAL and that is the only thing compose_files is for.
# Compose reads `--file` in order and later files win, so layering
# `docker-compose.siblings.yml` last is what puts the `build:` stanzas back.
# The alternative — passing it always and making the override a no-op when the
# flag is off — was rejected: a hatch that is always loaded is a second
# default, and two defaults is the failure mode this whole change is about.
#
# One argument per line on stdout, and both call sites read it with a `while
# read` loop rather than word-splitting a string, because a path with a space
# in it must not become two arguments. Neither path can contain one today (both
# are under $ROOT, which is derived from BASH_SOURCE) and the loop costs three
# lines, which is cheaper than the day it does.
compose_files() {
  printf -- '--file\n%s\n' "$COMPOSE_FILE"
  if [ "$BUILD_SIBLINGS" -eq 1 ]; then
    printf -- '--file\n%s\n' "$SIBLINGS_OVERRIDE"
  fi
}

compose() {
  local -a cf=()
  while IFS= read -r line; do cf+=("$line"); done < <(compose_files)
  docker compose \
    --project-name "$PROJECT" \
    --project-directory "$ROOT" \
    "${cf[@]}" \
    "$@"
}

# The same, under a deadline. `timeout` takes the program as its own argument,
# so it cannot wrap a shell function: the command is spelled out here once
# rather than at every call site, because a `timeout 420 compose up` reads as
# working and fails with "compose: No such file or directory" instead.
compose_timed() {
  local budget=$1
  shift
  local -a cf=()
  while IFS= read -r line; do cf+=("$line"); done < <(compose_files)
  timeout "$budget" docker compose \
    --project-name "$PROJECT" \
    --project-directory "$ROOT" \
    "${cf[@]}" \
    "$@"
}

elapsed_since() { echo $(($(date +%s) - $1)); }

# --- the cluster's init script -----------------------------------------------
# WHY THIS CHECK IS SEPARATE FROM `preflight`'s sibling checkouts, and it is the
# more interesting half of the pair. A missing `../identity` is caught by
# `docker build` naming a path that is not there. A missing `../kit` is not caught
# by anything at all, and that is the reason this function exists.
#
# `e2e/docker-compose.yml` mounts `../kit/templates/compose/postgres/initdb` over
# `/docker-entrypoint-initdb.d`. Two things follow from a bind mount, and both are
# silent:
#
#   1. A MISSING BIND SOURCE IS NOT AN ERROR TO DOCKER. It becomes an empty
#      directory, the mount succeeds, and initdb runs no script at all. The
#      cluster comes up with the superuser the image made and NOTHING else — no
#      `identity` role, no `identity_app`, no database owned by anything, and none
#      of the per-database `REVOKE ALL … FROM PUBLIC` that is the isolation. The
#      `healthcheck` on this service (`pg_isready -U identity -d identity`) does
#      not fire either, because the image created `identity` as `POSTGRES_USER`
#      before kit's script was ever consulted.
#   2. So the failure lands somewhere else entirely: `migrate` fires sixty
#      seconds later with a 42704 about `identity_app`, which is true, and which
#      a reader has no way to connect to a missing sibling checkout. The role is
#      the symptom. The checkout is the cause.
#
# The check therefore reads the mount OUT OF THE COMPOSE DOCUMENT rather than
# asserting a path, so it cannot disagree with the file that does the mounting, and
# it is called unconditionally: the mount is not behind `E2E_BUILD_SIBLINGS`, so
# neither is the checkout it needs.
check_cluster_initdb() {
  local src
  src=$(compose config --format json 2>/dev/null \
    | node -e '
      let raw = "";
      process.stdin.on("data", (chunk) => (raw += chunk));
      process.stdin.on("end", () => {
        const doc = JSON.parse(raw);
        const svc = (doc.services || {}).identity_postgres || (doc.services || {})["identity-postgres"] || {};
        const list = svc.volumes || [];
        const mount = list.find((v) => String(v.target || "").indexOf("/docker-entrypoint-initdb.d") === 0);
        process.stdout.write(String((mount && mount.source) || ""));
      });
    ') || die "cannot read the initdb mount of the postgres service out of $COMPOSE_FILE"

  [ -n "$src" ] \
    || die "the postgres service in $COMPOSE_FILE mounts nothing over /docker-entrypoint-initdb.d, so nothing will provision this cluster: no service roles, no bounded owner, and no REVOKE. identity's migration 00016 will then fail at cafaye.protect_table with 'identity_app is not a LOGIN role on this cluster' — which is a statement about the missing mount and reads like a statement about the migration."

  # `compose config` resolves the bind source to an absolute path, so this is the
  # directory Docker will mount rather than the string in the file.
  [ -d "$src" ] \
    || die "the initdb bind source $src does not exist. It is a ../kit checkout: docker compose mounts a missing bind source as an EMPTY DIRECTORY rather than failing, so a healthy cluster would come up with no roles and no isolation. Check out cafaye/kit beside this repository."

  # An existing but EMPTY directory is the same failure reached a different way,
  # and it is the one a plain `-d` test cannot see. Kit's directory is either
  # there or it is not, so "empty" means the checkout is the wrong repository, or
  # a partial one — and it is checked separately rather than folded into the test
  # above because the two failures have different fixes.
  [ -n "$(find "$src" -maxdepth 1 -type f -print -quit 2>/dev/null)" ] \
    || die "the initdb directory $src is empty, which means it was created rather than found — the same missing-checkout failure as above, and equally silent. Check out cafaye/kit beside this repository, at master."

  log "the cluster's init script is present: $src"
}

# --- the cluster's DATA DIRECTORY ----------------------------------------------
# WHY THIS IS A SEPARATE CHECK FROM THE INIT SCRIPT ABOVE, AND IT IS THE SAME
# FAILURE REACHED THE OTHER WAY ROUND.
#
# `check_cluster_initdb` asks whether kit's script is on disk. It cannot ask
# whether the script will ever RUN, and for a cluster that already exists the
# answer is no. **Docker runs `/docker-entrypoint-initdb.d` only when the data
# directory is empty** — that is the postgres image's documented behaviour, and it
# is what makes an existing cluster safe rather than what makes it dangerous. The
# danger is the other direction: a volume left over from a run that predates the
# mount, or from a checkout where the mount was absent, keeps a cluster that was
# initialised WITHOUT kit's script and will never be initialised with it.
#
# The measured failure, on this machine, 2026-10-05, and it cost a full stack run:
#
#   goose run: ERROR 00016_account_isolation.sql: failed to run SQL migration:
#   failed to execute SQL query "select cafaye.protect_table('account_users');":
#   ERROR: cafaye.protect_table(account_users, identity_app): identity_app is not
#   a LOGIN role on this cluster. (SQLSTATE 42704)
#
# `pg_roles` on that cluster held exactly one entry. Not "the wrong roles" — one
# role, `identity` itself, which is the superuser the image creates as
# `POSTGRES_USER`. So this is NOT the missing-`../kit` failure the check above
# describes, and that check passed: kit was checked out, the mount was there, and
# every preflight green. It is the same *symptom* from a different cause, and
# which of the two you are looking at is decided entirely by whether the volume
# was already there.
#
# So this asks the one question the other check cannot, and it asks it of the
# volume rather than of the file:
#
#   * NO volume — initdb runs on this start and roles exist. Nothing to do.
#   * volume present — initdb has already been skipped once, and will be skipped
#     again. `down -v` is the fix, and the check says so.
#
# It is a REFUSAL rather than a silent `down -v`, deliberately, for the same
# reason `down` documents its `-v`: the volumes hold a throwaway fixture, but
# deleting a volume nobody asked this script to delete is a destructive act done
# on a guess. The check names the volume it found, so the reader can see which
# one it means, and the fix is one command they can see is safe.
#
# `E2E_ALLOW_STALE_CLUSTER=1` is the escape hatch for the one legitimate case:
# somebody deliberately parked a cluster and wants it back. It is an env var
# rather than a flag because `bin/e2e` drives this script as a subprocess and
# adding a flag would mean changing both call sites to keep them in step.
check_cluster_freshness() {
  local vol="${PROJECT}_identity-postgres-data"
  docker volume inspect "$vol" >/dev/null 2>&1 || return 0

  [ "${E2E_ALLOW_STALE_CLUSTER:-0}" = "1" ] && {
    log "WARNING: reusing the existing cluster volume $vol, which was initialised without kit's script if that mount was absent then. Roles it should have created may not exist; expect a 42704 naming one of them."
    return 0
  }

  die "the cluster volume $vol already exists, so this start will NOT run kit's init script — the postgres image runs /docker-entrypoint-initdb.d only against an empty data directory, and a cluster that was initialised without it is never given the service roles.

This is not the missing-kit failure: that mount is present, or the preflight above would have said so. This volume was initialised before the mount existed, or before $PROJECT existed at all, so it carries whatever roles it was created with and none of the ones kit's script creates.

The fix is one command, and the volumes hold a throwaway fixture:

    docker compose --project-name $PROJECT --project-directory $ROOT -f $COMPOSE_FILE down -v

or run bin/e2e-stack down. Set E2E_ALLOW_STALE_CLUSTER=1 to reuse it anyway and accept a migration failure if the roles are not there."
}

# --- preflight --------------------------------------------------------------
# Everything this script needs, checked before anything is started, so the
# failure is "curl is not installed" rather than "the stack did not come up"
# after four minutes of building.
preflight() {
  need docker "Install Docker: https://docs.docker.com/get-docker/"
  need curl "curl is used to poll /readyz from the host."

  # `unzip` is used by the end-to-end tier's own guard, which reads Playwright's
  # artifacts member by member looking for a leaked session token (see
  # e2e/no-token-artifacts.ts). It is a prerequisite rather than a nicety: a
  # credential check that cannot open the archive it is checking silently finds
  # nothing, which is the exact failure it exists to prevent.
  need unzip "unzip reads the members of a Playwright trace. It ships with macOS and with every Linux CI image; 'apt-get install unzip' if yours does not have it."

  docker compose version >/dev/null 2>&1 \
    || die "docker compose (the v2 plugin) is not available. The harness needs it for 'up --wait'."

  # `goose` applies identity's migrations. It is identity's own documented
  # procedure (../identity/migrations/README.md) and it is deliberately NOT a
  # container here: pinning a third-party migration image into the fleet's
  # toolchain is a decision for identity and the manager, not for a test
  # harness. A missing goose is a loud, actionable failure — never a skip.
  need goose "Install it the way ../identity documents: mise, or 'go install github.com/pressly/goose/v3/cmd/goose@<pinned version>'."

  [ -f "$COMPOSE_FILE" ] || die "no compose file at $COMPOSE_FILE"

  # kit, for the cluster's init script, and UNCONDITIONALLY rather than in the
  # hatch. That asymmetry with the sibling checkouts below is the whole of this
  # function: a missing sibling checkout costs a slower run or a failed pull, both
  # of which name themselves, while a missing `../kit` costs a cluster that comes
  # up HEALTHY holding one superuser and no service roles — because Docker mounts a
  # missing bind source as an empty directory rather than refusing, initdb runs no
  # script, and nothing until the migration step sixty seconds later says so. The
  # failure that did happen is the record:
  #
  #   goose run: ERROR 00016_account_isolation.sql: failed to run SQL migration:
  #   failed to execute SQL query "select cafaye.protect_table('account_users');":
  #   ERROR: cafaye.protect_table(account_users, identity_app): identity_app is not
  #   a LOGIN role on this cluster. (SQLSTATE 42704)
  #
  # which names a missing ROLE rather than a missing CHECKOUT, sixty seconds and
  # three services away from the cause. So it is checked here, by name, before
  # anything starts.
  check_cluster_initdb
  check_cluster_freshness

  # The sibling checkouts are required ONLY in the hatch. While every image was
  # built from a sibling checkout they were unconditionally required, and that
  # check was correct; now the default path pulls published artifacts and a
  # machine with no sibling checkout is a perfectly ordinary one. Failing here
  # unconditionally would have made the default path unusable for exactly the
  # people who are not changing a sibling.
  if [ "$BUILD_SIBLINGS" -eq 1 ]; then
    [ -f "$SIBLINGS_OVERRIDE" ] \
      || die "E2E_BUILD_SIBLINGS=1 but there is no override file at $SIBLINGS_OVERRIDE"
    local sibling
    for sibling in "${SIBLING_SERVICES[@]}"; do
      [ -f "$ROOT/../$sibling/Dockerfile" ] \
        || die "E2E_BUILD_SIBLINGS=1 but there is no ../$sibling/Dockerfile. The hatch builds that image from its checkout; without it run the default path instead (unset E2E_BUILD_SIBLINGS), which pulls the published artifact."
    done
    log "sibling build mode: identity, gateway and oauth-stub will be built from their checkouts"
  fi

  ensure_oidc_signing_key
}

# ---------------------------------------------------------------------------
# The OIDC signing key, and why it is generated rather than committed
# ---------------------------------------------------------------------------
# identity refuses to boot unless OIDC_ISSUER, OIDC_SIGNING_KEY and
# OIDC_SIGNING_KEY_ID are all set or all unset, and its well-known routes are
# mounted only when they are. The gateway's identity readiness probe fetches
# the issuer's JWKS, so with the block absent the gateway's /readyz reports
# `{"deps":{"identity":"unavailable"}}` indefinitely and this harness spends its
# entire readiness budget proving it.
#
# So a key is needed, and it is generated here rather than committed for two
# reasons that are about the repository and not about convenience:
#
#   * A committed RSA private key is a private key in a repository. Even a
#     throwaway one trains every reader — human and scanner — that a PEM in
#     this tree is unremarkable, and `kit`'s gitleaks gate is right to treat
#     one as a finding.
#   * Nothing caches the key set across runs. gateway's JWKS cache is in the
#     container that fetched it, and a fresh `up` builds fresh containers, so a
#     key that changes per run costs nothing and a key that never changes would
#     be a key sitting in git for no benefit.
#
# Exporting rather than writing a file is what `e2e/docker-compose.yml` reads:
# the document interpolates `${OIDC_SIGNING_KEY:-}`, and compose renders a
# multi-line value as a literal block scalar, so the PEM reaches the container
# with its newlines intact. An operator who wants a fixed key exports one and
# this function leaves it alone.
ensure_oidc_signing_key() {
  if [ -n "${OIDC_SIGNING_KEY:-}" ]; then
    return 0
  fi
  need openssl "openssl generates identity's OIDC signing key at bring-up."
  # 2048 is identity's floor (internal/oidc/keys.go, MinKeyBits) and it is the
  # size every verifier on the platform expects. `-traditional` asks for the
  # PKCS#1 header, which is the first of the two encodings identity parses; the
  # default on OpenSSL 3 is PKCS#8 and identity accepts that too, so this is
  # about the file being readable at a glance rather than about correctness.
  local generated
  generated=$(openssl genrsa -traditional 2048 2>/dev/null) \
    || die "openssl could not generate an OIDC signing key."
  if [ -z "$generated" ]; then
    die "openssl produced an empty OIDC signing key."
  fi
  export OIDC_SIGNING_KEY="$generated"
}

# --- the host port a service publishes --------------------------------------
# Read out of the compose document so this file never holds a port number. The
# substitution's default is what a bare `docker compose run` would publish, and
# ${VAR:-default} is the whole grammar: anything more would be a YAML parser in
# a shell script.
host_port() {
  local service=$1
  local published
  published=$(compose config --format json 2>/dev/null \
    | node -e '
      let raw = "";
      process.stdin.on("data", (chunk) => (raw += chunk));
      process.stdin.on("end", () => {
        const doc = JSON.parse(raw);
        const svc = (doc.services || {})[process.argv[1]];
        const list = (svc && svc.ports) || [];
        // Compose normalizes a published port to an object; a string is the
        // short form. Either way the key is the host end.
        const first = list[0];
        if (first == null) { process.exit(1) }
        const host = typeof first === "string" ? Number(first.split(":")[0]) : Number(first.published);
        if (!Number.isInteger(host) || host <= 0) { process.exit(1) }
        process.stdout.write(String(host));
      });
    ' "$service") || die "cannot read the published host port for $service out of $COMPOSE_FILE"
  printf '%s' "$published"
}

# --- the registry ------------------------------------------------------------
# `docker compose up` resolves and pulls every `image:` in the document BEFORE
# it creates a single container, so a stack that pulls `identity` and `gateway`
# out of a registry that this same compose file is responsible for starting
# cannot start at all. Compose cannot express "start this one first, then pull
# those", so this is a separate step and it has to run first. There is no clever
# alternative: `depends_on` is not consulted during the pull phase, and
# setting `pull_policy: build` on the siblings would put the `build:` back that
# this change removed.
ensure_registry() {
  log "starting the registry the sibling artifacts are pulled from ($REGISTRY)"
  local started elapsed status
  started=$(date +%s)
  set +e
  compose_timed 120 up -d --wait registry
  status=$?
  set -e
  elapsed=$(elapsed_since "$started")
  if [ "$status" -ne 0 ]; then
    printf '[e2e] FAIL: the registry did not come up in %ss (exit %s)\n' "$elapsed" "$status" >&2
    printf '[e2e] identity, gateway and oauth-stub are pulled from it, so nothing else in this stack can start.\n' >&2
    printf '[e2e] if %s is meant to be a registry that already runs, unset it and let this stack own one.\n' "$REGISTRY" >&2
    compose logs --no-color --tail 50 registry 2>&1 | sed 's/^/[e2e] /' >&2 || true
    exit 1
  fi
  log "registry up in ${elapsed}s"
}

# --- publish the sibling artifacts -------------------------------------------
# THE UPSTREAM BUILD, and it is the step that makes "build once" mean something.
# It builds identity, gateway and oauth-stub from NAMED REFS of their checkouts,
# tags them, and pushes them to the registry. It is NOT called by `up` on the
# default path — that is the entire difference between this and the old behaviour
# — so a developer runs it when a sibling has moved and CI runs it once per run
# instead of three times inside compose.
#
# `docker build` rather than `compose build`, on purpose: `compose build` only
# builds services that have a `build:` stanza, and the default document no
# longer has one for the siblings. Building them from here keeps the tag name in
# exactly one place (sibling_tag) rather than in a compose file that is not
# supposed to name them.
#
# THE CONTEXT IS AN EXPORTED REF AND NOT THE CHECKOUT DIRECTORY. That is the whole
# of the `sibling_export_tree` comment above, and it is why a run can say which
# commit it tested even when the checkout has moved on underneath it.
#
# The tag is pushed under BOTH names: the registry-qualified one the compose
# file pulls, and the bare one a developer's `docker images` will show. The
# second is cosmetic and is why it is noted here — it is the name the hatch
# overwrites locally, which is the interaction e2e/docker-compose.siblings.yml
# documents.
publish_siblings() {
  preflight
  ensure_registry

  # THE TEMPORARY EXPORT DIRECTORIES, and why the trap exists at all.
  #
  # `cleanup` is `trap`ped and the list is a top-level `SIBLING_TMPDIRS` rather
  # than a `local`, because a `local` declared inside this function is gone by the
  # time the EXIT trap fires — after the function returned — and `set -u` then
  # turned the trap into `tmpdirs: unbound variable`, so the script exited 1
  # AFTER it had built, pushed and verified every image. A run that does the work
  # and then reports failure is worse than one that fails before doing it: the
  # next reader cannot tell which happened.
  #
  # `${SIBLING_TMPDIRS:-}` rather than `$SIBLING_TMPDIRS` for the same reason —
  # the trap also has to survive being armed in a script that never called this
  # function (`verify-sibling-images`, `host-port`, the usage print).
  cleanup() {
    local d
    for d in ${SIBLING_TMPDIRS:-}; do rm -rf "$d"; done
    return 0
  }
  trap cleanup EXIT
  SIBLING_TMPDIRS=""

  # WHAT IS PUBLISHED, printed before anything is built, so a reader of a failed
  # publish knows which commits were about to become the `:e2e` tag before they
  # read which ones did.
  local service ref sha started elapsed status ctx
  log "publishing from named refs, one commit per sibling:"
  for service in "${SIBLING_SERVICES[@]}"; do
    ref=$(sibling_ref "$service" | cut -d= -f2-)
    sha=$(sibling_revision "$service" "$ref")
    log "  $service  $ref  $(short_sha "$sha")  ($ROOT/../$service)"
  done

  for service in "${SIBLING_SERVICES[@]}"; do
    ref=$(sibling_ref "$service" | cut -d= -f2-)
    sha=$(sibling_revision "$service" "$ref")
    ctx=$(sibling_export_tree "$service" "$sha")
    SIBLING_TMPDIRS="$SIBLING_TMPDIRS $ctx"
    tag="$(sibling_tag "$service")"
    log "building $service from $ref ($(short_sha "$sha"))"
    started=$(date +%s)
    set +e
    # The build args are the siblings' own, and they are NOT inherited from the
    # override file because the override is not layered in this mode: this
    # command publishes what the named ref produces, which is the point of it.
    # `--build-arg` for an undeclared name is a warning rather than an error, so
    # a missing arg here produces an image that no deploy path has produced and
    # a green log. The sibling's Dockerfile is the place that fails loudly.
    #
    # The `--label`s are what make the artifact attributable; see
    # sibling_label_args for why they are not `org.opencontainers.*`, which on
    # gateway's image belongs to bun.
    local -a label_args=()
    while IFS= read -r one; do label_args+=("$one"); done < <(sibling_label_args "$service" "$ref" "$sha")
    case "$service" in
      identity)
        timeout "$BUILD_TIMEOUT" docker build \
          --build-arg SERVICE_NAME=identity \
          "${label_args[@]}" \
          --tag "cafaye/identity:$SIBLING_TAG_SUFFIX" \
          --tag "$REGISTRY/$tag" \
          "$ctx"
        ;;
      gateway)
        timeout "$BUILD_TIMEOUT" docker build \
          --build-arg BUN_VERSION=1.3.12 \
          "${label_args[@]}" \
          --tag "cafaye/gateway:$SIBLING_TAG_SUFFIX" \
          --tag "$REGISTRY/$tag" \
          "$ctx"
        ;;
      # oauth-stub is Go and takes NO `--build-arg` AT ALL, which is the point of
      # this arm and the reason it does not read like identity's above.
      #
      # READ THE DOCKERFILE, DO NOT PATTERN-MATCH ON "IT IS ALSO GO". At the ref
      # this tier pins (v0.1.0) `github.com/cafaye/oauth-stub`'s Dockerfile
      # declares exactly one argument, `ARG GO_VERSION=1.26`, and it is declared
      # WITH A DEFAULT. There is no `SERVICE_NAME`, because unlike identity's
      # monorepo layout the module is a single root package and the build line is
      # `go build … .`. So:
      #
      #   * `--build-arg SERVICE_NAME=oauth-stub` would be an UNDECLARED name.
      #     Docker warns and continues. The image builds, the run goes green, and
      #     nothing in the log says the harness asked for a build input the deploy
      #     path never sets. That is precisely the failure the comment above this
      #     `case` warns about, and the Dockerfile is the contract, not the
      #     resemblance to a sibling that happens to share its language.
      #   * `--build-arg GO_VERSION=1.26` would restate a pin that
      #     `../oauth-stub`'s own repository owns.
      #
      # `no go.sum` either: the module has no require block, deliberately, so
      # there is no dependency download step to feed and no argument for one.
      oauth-stub)
        timeout "$BUILD_TIMEOUT" docker build \
          "${label_args[@]}" \
          --tag "cafaye/oauth-stub:$SIBLING_TAG_SUFFIX" \
          --tag "$REGISTRY/$tag" \
          "$ctx"
        ;;
      *)
        printf '[e2e] FAIL: no build recipe for sibling %s\n' "$service" >&2
        exit 1
        ;;
    esac
    status=$?
    set -e
    elapsed=$(elapsed_since "$started")
    if [ "$status" -ne 0 ]; then
      printf '[e2e] FAIL: building %s from %s failed after %ss (exit %s)\n' "$service" "$ref" "$elapsed" "$status" >&2
      exit 1
    fi
    log "  $service built in ${elapsed}s from $ref ($(short_sha "$sha"))"
  done

  for service in "${SIBLING_SERVICES[@]}"; do
    tag="$(sibling_tag "$service")"
    log "pushing $REGISTRY/$tag"
    set +e
    timeout 300 docker push "$REGISTRY/$tag"
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
      printf '[e2e] FAIL: pushing %s failed (exit %s). The tag is built but not published, and the default path pulls by tag.\n' "$REGISTRY/$tag" "$status" >&2
      exit 1
    fi
  done

  # AND PROVE IT, before this function claims to have published anything. A push
  # that succeeded says the registry accepted bytes; it says nothing about which
  # commits those bytes were built from, and this function's entire reason to
  # exist is that the answer used to depend on the machine.
  verify_sibling_images

  # TWO facts, and this is why BOTH lines are here. They are not two copies of
  # one fact, which is the only reason this comment exists.
  #
  #   the digest — WHICH BYTES. `repo@sha256:…` is the registry's content
  #     address. Two rebuilds of one commit produce two of them, so it is the
  #     only attribution to the artifact itself and the only one that survives
  #     a stamp being absent or lying.
  #   the stamp  — WHICH CODE. `--verify` prints source/revision/built_at and
  #     never prints a digest, so it cannot reproduce the line above.
  #
  # The stamp packet's handoff calls the verifier a *supersession* of the digest
  # line. Measured, it is not: removing the digest would delete half of what a
  # reader of this log can learn, and the verifier has never claimed the right
  # to replace a sha256.
  #
  # THE DECISION: the stamp line PRINTS and does not ASSERT. `|| true` is
  # scoped to this one call and the reason is measured, not stylistic — both
  # numbers below come from this machine's own sibling images:
  #
  #   * `publish_siblings` builds identity, gateway and oauth-stub with a bare
  #     `docker build` passing only the one `--build-arg` each sibling's Dockerfile
  #     declares. It passes no `KIT_PROVENANCE_*` argument, and neither
  #     `identity/Dockerfile` nor `gateway/Dockerfile` declares the stamp at all.
  #     So `cafaye/identity:e2e` reports labels `null` and `--verify` exits 4 on
  #     every ordinary run of this tier. Asserting would make the e2e tier red
  #     permanently for a drift that lives in two repositories this one may not
  #     touch.
  #   * `cafaye/gateway:e2e` is worse than unstamped: its labels are BUN's
  #     upstream ones (`source: https://github.com/oven-sh/bun`, a revision of
  #     bun's own commit), inherited through `FROM oven/bun`. `--verify` exits 0
  #     on it and prints a confident, false answer.
  #
  # So the print is worth having — it surfaces both facts and it is where the
  # next reader learns that the siblings do not stamp themselves yet — and the
  # assertion is not available here. What is NOT available is the assurance:
  # `tests/provenance-consumer-test.sh` is the proof that `--verify` can go red,
  # because nothing in this tier can.
  local digest
  for service in "${SIBLING_SERVICES[@]}"; do
    tag="$(sibling_tag "$service")"
    digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "$REGISTRY/$tag" 2>/dev/null || echo "(no repo digest)")
    log "  published $service -> $REGISTRY/$tag  $digest"
    # What am I? The stamp a pulled image carries — see docker/provenance.sh.
    sh "$ROOT/docker/provenance.sh" --verify "$REGISTRY/$tag" || true
  done
}

# ---------------------------------------------------------------------------
# WHICH SOURCE AN IMAGE WAS BUILT FROM, as a countable check
# ---------------------------------------------------------------------------
# The reader, for one sibling. It asks the IMAGE what it is and the CHECKOUT
# what the ref means, and it refuses to say "fine" unless both agree — a stamp is
# only as good as the claim it was written by, and this function is the reason
# the claim is written at all.
#
# FOUR ANSWERS, and the last two are the ones that matter:
#
#   attributable and on the ref   the ordinary case, printed as one row
#   attributable, ref is ahead    the image is an ANCESTOR of the named ref,
#                                 which is legal: the pin moved back, or the
#                                 tag is older than master
#   not attributable              no stamp: something else published it
#   built from the WRONG place    stamped, but not an ancestor of the ref — an
#                                 in-flight branch, which is the measured 401
#
# NO CHECKOUT BESIDE THIS REPO is a counted row, not a silent pass and not a
# failure. `bin/e2e` is meant to run on a machine that has this repository and
# nothing else, and there the registry is the source of truth; the checkout cannot
# be required without breaking that case for the wrong reason. What is then
# checked is the stamp alone, which is a weaker claim and is printed as one. The
# summary row says how many siblings got the full check, so a reader never has to
# infer it from an absence.
verify_sibling_image() {
  local service=$1 image=$2 want_ref want_sha stamped_ref stamped_sha dirty
  local dir

  want_ref=$(sibling_ref "$service" | cut -d= -f2-)
  dir="$ROOT/../$service"

  # `docker image inspect` on a reference that is not present locally exits 1 and
  # prints a multi-line error; the label template therefore has to be the whole
  # command, and a miss has to be turned into a sentence rather than propagated.
  stamped_sha=$(docker image inspect --format '{{index .Config.Labels "cafaye.e2e.revision"}}' "$image" 2>/dev/null || true)
  stamped_ref=$(docker image inspect --format '{{index .Config.Labels "cafaye.e2e.source"}}' "$image" 2>/dev/null || true)
  dirty=$(docker image inspect --format '{{index .Config.Labels "cafaye.e2e.dirty"}}' "$image" 2>/dev/null || true)

  if [ -z "$stamped_sha" ] || [ "$stamped_sha" = "<no value>" ]; then
    printf '[e2e] FAIL: %s is not attributable\n' "$service" >&2
    printf '[e2e]   image:  %s\n' "$image" >&2
    printf '[e2e]   it carries no cafaye.e2e.revision label, so it was not published by\n' >&2
    printf '[e2e]   this harness and this harness cannot say what is inside it. Building and\n' >&2
    printf '[e2e]   pushing it again from a named ref is what makes it attributable:\n' >&2
    printf '[e2e]     ./bin/e2e-stack publish-siblings\n' >&2
    return 1
  fi

  if [ ! -d "$dir/.git" ]; then
    printf '[e2e]   %s stamped %s (%s); not verified against a checkout — there is no ../%s beside this repo\n' \
      "$service" "$(short_sha "$stamped_sha")" "$stamped_ref" "$service" >&2
    return 0
  fi

  if ! git -C "$dir" cat-file -e "${stamped_sha}^{commit}" 2>/dev/null; then
    printf '[e2e] FAIL: %s was built from a commit this repository does not have\n' "$service" >&2
    printf '[e2e]   image:      %s\n' "$image" >&2
    printf '[e2e]   stamped:    %s (%s)\n' "$(short_sha "$stamped_sha")" "$stamped_ref" >&2
    printf '[e2e]   ../%s has no such object, so the image cannot be reconciled with any ref in it.\n' "$service" >&2
    return 1
  fi

  if [ "$dirty" = "true" ]; then
    printf '[e2e] FAIL: %s was built from a DIRTY tree\n' "$service" >&2
    printf '[e2e]   image: %s, stamped cafaye.e2e.dirty=true\n' "$image" >&2
    printf '[e2e]   A dirty tree has no ref, so "which source" has no answer for this image.\n' >&2
    return 1
  fi

  want_sha=$(sibling_revision "$service" "$want_ref")
  if ! git -C "$dir" merge-base --is-ancestor "$stamped_sha" "$want_sha" 2>/dev/null; then
    printf '[e2e] FAIL: %s was built from %s, which is NOT on %s\n' "$service" "$(short_sha "$stamped_sha")" "$want_ref" >&2
    printf '[e2e]   image:             %s\n' "$image" >&2
    printf '[e2e]   stamped source:    %s\n' "$stamped_ref" >&2
    printf '[e2e]   %s resolves to:  %s in ../%s\n' "$want_ref" "$(short_sha "$want_sha")" "$service" >&2
    printf '[e2e]   That is an in-flight branch or a rewrite, and a stack built from it can\n' >&2
    printf '[e2e]   come up green while answering 401 on the request this tier exists to prove.\n' >&2
    printf '[e2e]   For oauth-stub that has a second meaning: the pin is a FIXTURE pin, so an\n' >&2
    printf '[e2e]   image from off the tag is a different double than the assertions were written\n' >&2
    printf '[e2e]   against. To test a branch on purpose, name it:\n' >&2
    printf '[e2e]     E2E_SIBLING_REF_%s=%s ./bin/e2e\n' "$(printf '%s' "$service" | tr '[:lower:]-' '[:upper:]_')" "$stamped_ref" >&2
    return 1
  fi

  if [ "$stamped_sha" = "$want_sha" ]; then
    printf '[e2e]   %s -> %s (%s) is %s\n' "$service" "$image" "$(short_sha "$stamped_sha")" "$want_ref"
  else
    printf '[e2e]   %s -> %s (%s) is an ancestor of %s (%s)\n' \
      "$service" "$image" "$(short_sha "$stamped_sha")" "$want_ref" "$(short_sha "$want_sha")"
  fi
  return 0
}

# One row per sibling and a summary, so "it passed" and "it passed and told me
# what it could not check" are different strings. Non-zero if any sibling is
# unattributable.
verify_sibling_images() {
  local service image ok=0 failed=0 checked=0
  for service in "${SIBLING_SERVICES[@]}"; do
    image="$REGISTRY/$(sibling_tag "$service")"
    if [ -d "$ROOT/../$service/.git" ]; then
      checked=$((checked + 1))
    fi
    if verify_sibling_image "$service" "$image"; then
      ok=$((ok + 1))
    else
      failed=$((failed + 1))
    fi
  done
  printf '[e2e] sibling origins: %d/%d attributable, %d verified against a checkout in ../\n' \
    "$ok" "${#SIBLING_SERVICES[@]}" "$checked"
  if [ "$checked" -lt "${#SIBLING_SERVICES[@]}" ]; then
    printf '[e2e]   %d of them were checked on their stamp alone — no checkout beside this repo to reconcile it against.\n' \
      "$(( ${#SIBLING_SERVICES[@]} - checked ))"
  fi
  [ "$failed" -eq 0 ] || return 1
  return 0
}

# --- build ------------------------------------------------------------------
# ONE image. This used to be three, and the reduction is the change rather than
# a side effect of it: the sibling images are consumed from the registry (or
# built from their checkouts by publish_siblings / the hatch), and only the
# service under test is rebuilt from this working tree.
build() {
  preflight
  if [ "$BUILD_SIBLINGS" -eq 1 ]; then
    log "building images (budget ${BUILD_TIMEOUT}s) — sibling build mode"
    log "  identity  <- ../identity, built into cafaye/identity:e2e (NOT pushed)"
    log "  gateway   <- ../gateway, built into cafaye/gateway:e2e (NOT pushed)"
    log "  oauth-stub <- ../oauth-stub, built into cafaye/oauth-stub:e2e (NOT pushed)"
  else
    log "building images (budget ${BUILD_TIMEOUT}s)"
    log "  parlor    <- . (no build args: the BFF reads IDENTITY_URL at run time)"
    log "  identity, gateway, oauth-stub, postgres, redis, nginx and registry: pulled, not built"
  fi
  log "  edge      <- nginx, a pinned image: see e2e/edge.conf for why it exists"
  local started elapsed status
  started=$(date +%s)
  set +e
  # `E2E_BUILD_FLAGS` exists for one measurement: `--no-cache`, for the cold-run
  # number in the report. It is an array on purpose, so a caller cannot smuggle
  # a second command in through a string.
  compose_timed "$BUILD_TIMEOUT" build ${E2E_BUILD_FLAGS[@]+"${E2E_BUILD_FLAGS[@]}"}
  status=$?
  set -e
  elapsed=$(elapsed_since "$started")
  if [ "$status" -ne 0 ]; then
    # Buildkit's own output has already gone to stderr; what is missing is the
    # sentence saying which image and how long it had.
    printf '[e2e] FAIL: image build failed after %ss (exit %s)\n' "$elapsed" "$status" >&2
    dump_state
    exit 1
  fi
  log "images built in ${elapsed}s"
}

# --- make the sibling artifacts available -------------------------------------
# The resolver, and the order is the whole design:
#
#   1. hatch mode (`E2E_BUILD_SIBLINGS=1`): build() has already produced the three
#      images under their local tags. Nothing to resolve and nothing to pull —
#      and specifically nothing to pull, because pulling the registry tag here
#      would overwrite the working-tree build the developer just asked for.
#   2. the tag is already in the registry AND cached here: pull nothing. This is
#      the steady state and it is the fast path.
#   3. published but not cached, or published nowhere: pull it, and if there is
#      nothing there to pull, publish once from the checkouts and ANNOUNCE that
#      this run therefore tested a working tree rather than a published artifact.
#      A reader of a green e2e run is entitled to know which of the two they got.
#   4. neither a registry nor a checkout can produce one: fail, loudly, naming
#      the command that fixes it.
#
# Step 3's publish is the only place the default path builds a sibling, and it is
# reachable only when the artifact does not already exist — which is the honest
# reading of "build once upstream": somebody has to build it the first time, and
# the difference is that it is then a named, published tag rather than an
# anonymous local one.
ensure_sibling_artifacts() {
  if [ "$BUILD_SIBLINGS" -eq 1 ]; then
    log "sibling artifacts: built from the working tree by the hatch, nothing to pull"
    # THE ONE PATH THIS HARNESS CANNOT ATTRIBUTE, and it says so on every run
    # rather than only in a comment. The hatch hands the build to the compose
    # document (`e2e/docker-compose.siblings.yml`, `context: ../<name>`), and
    # compose has no way to set image labels — `labels:` on a service labels the
    # CONTAINER, not the image — so the artifacts of this path carry no
    # `cafaye.e2e.*` stamp and cannot be reconciled against anything.
    #
    # That is acceptable here and only here, for three reasons worth stating
    # rather than assuming: the path is opt-in under a flag named after what it
    # does; it does not push, so it cannot replace a published artifact for
    # anybody else; and building from the working tree is precisely what somebody
    # who set the flag asked for. It is printed because a reader of a green run
    # is entitled to know which of the two they got, and a countable row is the
    # difference between knowing and inferring.
    printf '[e2e] NOTE: hatch mode — identity, gateway and oauth-stub are built by docker compose\n' >&2
    printf '[e2e]       from ../identity, ../gateway and ../oauth-stub, so this run tests whatever is in\n' >&2
    printf '[e2e]       those working trees and nothing here can tell you which commit that was.\n' >&2
    printf '[e2e]       For a run that CAN be attributed, use the default path.\n' >&2
    return 0
  fi

  # ASK THE REGISTRY, NOT THE LOCAL CACHE. This loop used to accept a hit from
  # `compose image inspect` OR from `docker image ls`, both of which read the
  # LOCAL image store, and then logged "already published at $REGISTRY". That
  # made a green tier's central claim unfalsifiable: a machine with a warm cache
  # reported a registry as holding artifacts it had never been asked about.
  #
  # Measured, three consecutive ordinary runs on this machine, no intervention:
  #   * run 1 — registry recreated by `down -v`, catalog empty, cache warm
  #              -> "2/2 already published at localhost:16010, nothing to pull",
  #                 23 passed, exit 0. The registry had been up for 6 seconds and
  #                 had never held a blob.
  #   * run 2 — same, after a legitimate pull, so the cache is warm BY DESIGN
  #              -> the same false line.
  #
  # So the fix is to make the question the code asks match the sentence it logs.
  # `docker manifest inspect` talks to the registry over the network and is the
  # only probe here that can answer "is this published"; it is deliberately NOT
  # `docker image inspect`, which would reintroduce the identical defect under a
  # different spelling.
  #
  # `--insecure` is NOT optional and its absence is a bug this file shipped for
  # one run and then fixed, so the reason is written down rather than left as a
  # flag somebody would delete as redundant. This registry is plain HTTP on
  # localhost:16010, and without `--insecure` `docker manifest inspect` exits 1
  # with "no such manifest" for a tag the registry is serving with a 200. It
  # fails toward NOT PUBLISHED, so the symptom is the fast path never being
  # taken: every run announces a pull, and the "published, nothing to pull"
  # line this branch exists to print is unreachable. Measured on a registry
  # holding both artifacts:
  #
  #   docker manifest inspect              localhost:16010/...:e2e  -> exit 1
  #   docker manifest inspect --insecure   localhost:16010/...:e2e  -> exit 0
  #   curl -o /dev/null -w %{http_code}     .../manifests/e2e       -> 200
  #
  # That is the third time in this repository that a probe was believed because
  # it returned something, rather than checked against the thing it claims to
  # measure. The `--insecure` registry and a manifest fetch that both say "no"
  # while the registry says "yes" is the failure mode; a probe that cannot fail
  # on a populated registry is not a probe.
  #
  # A cached artifact is not thereby a published one. The two are separate
  # facts and each one, when false, means the artifact has to be pulled:
  #
  #   published && cached  -> the steady state, and the only case where the
  #                           correct log line is "nothing to pull"
  #   published && !cached -> the ordinary case on a second machine; pull it
  #   !published           -> nothing to pull BY; fall through to the checkouts
  #
  # Collapsing the first column into "do I have this tag locally" is what made
  # the previous version log "already published" for a registry that had never
  # held a blob, so both columns are computed here and neither stands in for
  # the other.
  local service tag present=0 missing="" unpublished=""
  for service in "${SIBLING_SERVICES[@]}"; do
    tag="$REGISTRY/$(sibling_tag "$service")"
    if timeout 60 docker manifest inspect --insecure "$tag" >/dev/null 2>&1; then
      present=$((present + 1))
      # Published is not cached. Compose will not use what is not here, so this
      # has to be a pull even though the registry has answered.
      if [ -z "$(docker image ls -q "$tag" 2>/dev/null || true)" ]; then
        unpublished="$unpublished $service"
      fi
    else
      missing="$missing $service"
    fi
  done

  if [ -z "$missing" ]; then
    if [ -n "$unpublished" ]; then
      # The steady state minus the cache. Pull rather than return, because
      # compose's default pull policy is `missing` and it would fetch the same
      # bytes itself one step later — this way the log says what happened.
      log "sibling artifacts: $present/${#SIBLING_SERVICES[@]} published at $REGISTRY, not all cached locally"
      missing="$unpublished"
    else
      # "published", and each tag with the digest that was verified over the
      # network. The digest is here so this line can be checked against the
      # registry after the fact rather than taken on trust, which is the
      # standard the previous version of this sentence failed.
      log "sibling artifacts: $present/${#SIBLING_SERVICES[@]} published at $REGISTRY, verified over the network, nothing to pull"
      for service in "${SIBLING_SERVICES[@]}"; do
        tag="$REGISTRY/$(sibling_tag "$service")"
        log "  $service -> $(timeout 60 docker manifest inspect --insecure --verbose "$tag" 2>/dev/null \
          | sed -n 's/.*"digest": *"\(sha256:[0-9a-f]*\)".*/\1/p' | head -1)"
      done
      # "PUBLISHED AND CACHED" IS NOT "RIGHT", and this is where that used to end.
      # Everything above asks the registry and the local store whether a tag
      # EXISTS. None of it asks what is in the tag, and a tag built from an
      # in-flight branch of a sibling exists quite happily — that is the measured
      # 401 in the sibling_export_tree comment. So the fast path verifies too: it
      # is a handful of `docker image inspect` calls and no I/O.
      verify_sibling_images || {
        printf '[e2e] FAIL: the sibling artifacts already published here cannot be reconciled\n' >&2
        printf '[e2e] with the refs this harness means. They are present and were served over the\n' >&2
        printf '[e2e] network, and they are not what this run is supposed to test — the check\n' >&2
        printf '[e2e] above names the ref and the commit for each one. Rebuild them:\n' >&2
        printf '[e2e]   ./bin/e2e-stack publish-siblings\n' >&2
        exit 1
      }
      return 0
    fi
  fi

  # Either never published, or published but not cached here. Ask the registry
  # by pulling, which is also what puts the artifact in the local store for
  # compose.
  local pulled=""
  set +e
  for service in $missing; do
    tag="$REGISTRY/$(sibling_tag "$service")"
    log "pulling $tag"
    if timeout 300 docker pull "$tag" >/dev/null 2>&1; then
      pulled="$pulled $service"
    else
      printf '[e2e]   %s is not in %s\n' "$tag" "$REGISTRY" >&2
    fi
  done
  set -e

  still_missing=""
  for service in "${SIBLING_SERVICES[@]}"; do
    case " $pulled " in *" $service "*) ;; *) still_missing="$still_missing $service" ;; esac
  done
  [ -z "$still_missing" ] && { log "sibling artifacts: pulled from $REGISTRY"; return 0; }

  # Still missing. A checkout is the only thing left that can produce one.
  local sibling
  have_all_checkouts=1
  for sibling in "${SIBLING_SERVICES[@]}"; do
    [ -f "$ROOT/../$sibling/Dockerfile" ] || have_all_checkouts=0
  done

  if [ "$have_all_checkouts" -eq 1 ]; then
    log "not published at $REGISTRY and the sibling checkouts are here; publishing once"
    printf '[e2e] NOTE: these three images are being built from ../identity, ../gateway\n' >&2
    printf '[e2e]       and ../oauth-stub, so this run tests YOUR working trees, not a published\n' >&2
    printf '[e2e]       artifact. After ./bin/e2e-stack publish-siblings the registry tag is the one\n' >&2
    printf '[e2e]       used.\n' >&2
    publish_siblings
    return 0
  fi

  printf '[e2e] FAIL: no %s artifact for %s\n' "$(sibling_tag "$service")" "$missing" >&2
  printf '[e2e] The default path consumes identity, gateway and oauth-stub as published images, and\n' >&2
  printf '[e2e] neither the registry nor a sibling checkout has one. Either:\n' >&2
  printf '[e2e]   ./bin/e2e-stack publish-siblings   (with ../identity, ../gateway and ../oauth-stub)\n' >&2
  printf '[e2e]   E2E_BUILD_SIBLINGS=1 ./bin/e2e       (build the working trees instead)\n' >&2
  printf '[e2e]   E2E_REGISTRY=<host:port> ...        (if a persistent registry should serve this)\n' >&2
  exit 1
}

# --- up ---------------------------------------------------------------------
up() {
  preflight
  # The registry comes first, always, and not because it is a dependency of the
  # build: `docker compose up` pulls every `image:` before it creates a single
  # container, so a stack that pulls identity, gateway and oauth-stub out of the
  # registry it is about to start cannot start. This is the first step for that
  # reason and for no other.
  ensure_registry
  ensure_sibling_artifacts
  build

  log "starting the stack in project $PROJECT"
  local started elapsed status
  started=$(date +%s)

  # NOT `up --wait`, on purpose, and the reason is a measured failure on this
  # machine: `--wait` fails the moment a container is *currently* unhealthy, and
  # it carries health state over from a previous run. A guard container left
  # unhealthy by an earlier attempt (when identity had not been created yet)
  # makes the next `up --wait` fail in six seconds against a stack that is
  # perfectly healthy by then.
  #
  # What is left is the right shape anyway:
  #   * compose still blocks on `depends_on: condition: service_healthy` for the
  #     infrastructure, so postgres and redis are ready before anything that
  #     needs them starts. That ordering is a property of the document, and it
  #     is the ordering that has to be in the document.
  #   * the gate for the suite is the bounded host poll on /readyz below, which
  #     is the signal the packet asks for and the only one a container cannot
  #     make a claim about on its own behalf.
  set +e
  compose_timed "$UP_TIMEOUT" up -d
  status=$?
  set -e
  elapsed=$(elapsed_since "$started")
  if [ "$status" -ne 0 ]; then
    printf '[e2e] FAIL: the stack did not start in %ss (exit %s)\n' "$elapsed" "$status" >&2
    dump_state
    exit 1
  fi
  log "containers started in ${elapsed}s (dependency health ordered)"

  migrate
  wait_ready
}

# --- migrations -------------------------------------------------------------
# A deploy step, run as one. identity never migrates itself, so skipping this
# produces a stack that comes up perfectly and then refuses every sign-in,
# which is a far worse first minute than a step that says what it is doing.
migrate() {
  local port dsn
  port=$(host_port identity-postgres)
  # AS `identity`, THE OWNER, and not as the cluster's superuser. That is
  # unchanged from before kit's script was mounted, and it is a decision rather
  # than an inheritance: `00016_account_isolation.sql` builds every policy with
  # `to <current_user>, <login>`, so the role that APPLIES the migration is part
  # of what the migration means. Migrating as `postgres` would have written
  # `postgres` into all twenty policies and named the cluster administrator as the
  # owner of identity's tables — a different isolation, applied by a test
  # harness, in a repository this one may not edit the answer to.
  #
  # THE PASSWORD IS THE CLUSTER'S, and it is a consequence of kit's script rather
  # than a choice: it hands `$POSTGRES_PASSWORD` to every role it creates, so
  # `identity`'s password is the `POSTGRES_PASSWORD` in e2e/docker-compose.yml.
  # That is kit's stated position — isolation here is by privilege and never by
  # secret — and it is what lets the boundary be demonstrated by somebody who
  # knows every password in the cluster.
  dsn="postgres://identity:postgres@127.0.0.1:${port}/identity?sslmode=disable"
  log "applying identity's migrations (../identity/migrations) as identity"
  local started elapsed status
  started=$(date +%s)
  set +e
  # `-dir` is relative to this script's working directory on purpose: it is the
  # sibling's migrations, at the path identity's own README documents, not a
  # copy of them that could drift.
  (cd "$ROOT/../identity" && timeout 120 goose -dir migrations postgres "$dsn" up)
  status=$?
  set -e
  elapsed=$(elapsed_since "$started")
  if [ "$status" -ne 0 ]; then
    printf '[e2e] FAIL: identity migrations failed after %ss (exit %s)\n' "$elapsed" "$status" >&2
    printf '[e2e] the database this ran against is postgres on host port %s\n' "$port" >&2
    exit 1
  fi
  log "migrations applied in ${elapsed}s"
}

# --- readiness --------------------------------------------------------------
# The gate. A bounded poll on a published `/readyz`, per service, in dependency
# order, with a checkpoint on every poll so a slow start is visible while it is
# happening rather than inferred afterwards from how long it took.
wait_ready() {
  log "waiting for /readyz on ${READY_SERVICES[*]} (budget ${READY_TIMEOUT}s each)"
  local service port url deadline started elapsed attempt
  for service in "${READY_SERVICES[@]}"; do
    if [ "$service" = "identity-postgres" ]; then
      # Postgres has no /readyz; its readiness is `pg_isready` inside the
      # container, which `up --wait` has already blocked on. Saying so, rather
      # than probing something that does not exist, is the difference between a
      # finding and a reason to sleep.
      continue
    fi
    port=$(host_port "$service")
    # Every service in this stack answers /readyz on its published port, and
    # `edge` is no exception: it has no readiness endpoint of its own, so the
    # route it publishes is the app's, proxied. Asking the edge for /readyz is
    # therefore a real question with a real answer — "can a browser reach the
    # app and the app's idea of readiness" — and it is the one question a
    # browser's first navigation will ask.
    url="http://127.0.0.1:${port}/readyz"
    started=$(date +%s)
    deadline=$((started + READY_TIMEOUT))
    attempt=0
    while :; do
      attempt=$((attempt + 1))
      if curl --silent --show-error --fail --max-time 3 "$url" >/dev/null 2>&1; then
        log "  $service ready after $(elapsed_since "$started")s ($attempt polls) — $url"
        break
      fi
      if [ "$(date +%s)" -ge "$deadline" ]; then
        printf '[e2e] FAIL: %s did not answer %s within %ss (%s polls)\n' \
          "$service" "$url" "$READY_TIMEOUT" "$attempt" >&2
        printf '[e2e] its last answer, if any:\n' >&2
        curl --silent --show-error --max-time 3 "$url" 2>&1 | sed 's/^/[e2e]   /' >&2 || true
        dump_state
        exit 1
      fi
      # A checkpoint every five polls. Not a sleep to pass time: the loop
      # re-probes after it, and the deadline above is what ends the wait.
      if [ $((attempt % 5)) -eq 0 ]; then
        log "  $service not ready after $(elapsed_since "$started")s ($attempt polls) — still trying"
      fi
      sleep "$POLL_INTERVAL"
    done
  done
  log "the whole stack is ready"
}

# --- failure output ---------------------------------------------------------
# Everything a reader needs to diagnose a bring-up failure, printed on the way
# out. The order is deliberate: what is running, then what is NOT, then the logs
# of the things that are not — because "the stack did not come up" plus twelve
# unrelated log dumps is the same hour, just with more scrollback.
dump_state() {
  printf '\n[e2e] ===== stack state =====\n' >&2
  compose ps -a 2>&1 | sed 's/^/[e2e] /' >&2 || true

  local unhealthy
  # Read `.Health` rather than parsing `.Status`: compose's status string is
  # prose ("Up About a minute (unhealthy)"), and matching prose is how the first
  # version of this function printed the stack state and then said "no service
  # was unhealthy" while a container was visibly marked unhealthy in the table
  # two lines above it. Measured, not predicted.
  unhealthy=$(compose ps -a --format '{{.Service}}|{{.State}}|{{.Health}}' 2>/dev/null \
    | awk -F'|' '$2 != "running" || $3 == "unhealthy" || $3 == "" && $2 == "exited" {print $1}' || true)
  if [ -n "$unhealthy" ]; then
    printf '\n[e2e] ===== not up: %s =====\n' "$(echo "$unhealthy" | tr '\n' ' ')" >&2
    local service
    for service in $unhealthy; do
      printf '\n[e2e] ----- logs: %s -----\n' "$service" >&2
      compose logs --no-color --tail 200 "$service" 2>&1 | sed 's/^/[e2e] /' >&2 || true
    done
  else
    # Nothing is unhealthy, which means the failure is not a container: a port
    # that is already bound, a build that produced nothing, a migration that
    # did not apply. Say that, because otherwise the reader assumes the logs
    # above were empty because the logs were uninformative.
    printf '\n[e2e] no container is unhealthy: the failure is above this line, not in a container\n' >&2
  fi
  printf '\n[e2e] ===== end stack state =====\n' >&2
}

# --- down -------------------------------------------------------------------
down() {
  log "stopping $PROJECT and deleting its volumes"
  # `-v` on purpose: a stale database is a schema from a previous checkout, and
  # an E2E suite that passes against yesterday's migrations has verified
  # nothing. The volumes hold a throwaway fixture, not anybody's data.
  compose_timed 120 down -v --remove-orphans 2>&1 | sed 's/^/[e2e] /' || true
  log "stopped"
}

case "${1:-}" in
  build) build ;;
  publish-siblings) publish_siblings ;;
  up) up ;;
  wait) preflight; wait_ready ;;
  # The published host port for a service, on stdout and nothing else. A second
  # script needs these numbers (bin/e2e hands them to Playwright) and the port
  # block lives in exactly one file, so the reader is this function and not a
  # literal somebody copied.
  host-port) [ $# -ge 2 ] || die "usage: bin/e2e-stack host-port <service>"; host_port "$2" ;;
  # Which ref each sibling image was built from, as a check rather than a log.
  # It existed before the pin (registry-e2e-02) and became load-bearing with
  # it: `verify-sibling-images oauth-stub` is how a reader confirms the double
  # these assertions were written against is the one in the local image store, and
  # `v0.1.0` on stdout is the whole answer when it is.
  #
  # With no argument it checks every sibling, which is what `publish_siblings`
  # and the `ensure_sibling_artifacts` fast path call. With one, it checks that
  # one. With two, the second is any image reference — a developer's own local
  # `cafaye/oauth-stub:e2e`, say — because the question is about the image rather
  # than about a name this harness chose.
  # The one-argument form resolves the image itself, to
  # `$REGISTRY/$(sibling_tag "$1")` — the same expression the loop over
  # SIBLING_SERVICES builds — so naming a sibling is enough and the answer cannot
  # name an image the rest of the harness does not mean. The TWO-argument form is
  # kept for the case it is always for: an image that is NOT the registry one,
  # which is what a developer pointing this at their own `cafaye/oauth-stub:e2e`
  # after `E2E_BUILD_SIBLINGS=1` needs.
  verify-sibling-images)
    shift
    case $# in
      0) verify_sibling_images ;;
      1)
        # An unknown name is refused HERE rather than reported as an unverified
        # image. `sibling_tag` will happily name a tag for a service that does not
        # exist, and the check would then print a confident FAILURE about a missing
        # label on an image nobody ever published — which is a very confusing way to
        # say "you typed the name wrong", and it is a check that fails for a reason
        # other than the one it exists to catch.
        case " ${SIBLING_SERVICES[*]} " in
          *" $1 "*) ;;
          *) die "no sibling called '$1'; this tier consumes ${SIBLING_SERVICES[*]}. 'verify-sibling-images' with no arguments checks all of them." ;;
        esac
        verify_sibling_image "$1" "$REGISTRY/$(sibling_tag "$1")"
        ;;
      2) verify_sibling_image "$1" "$2" ;;
      *) die "usage: bin/e2e-stack verify-sibling-images [<service> [<image>]]" ;;
    esac
    ;;
  logs) shift; compose logs --no-color "$@" ;;
  ps) compose ps -a ;;
  down) down ;;
  *)
    # The usage is the header comment, and only the header comment: printing
    # more than that answers a question nobody asked, and the line range is the
    # only thing keeping the two in step. `sed -n '4,12p'` is the block from the
    # first subcommand through the last, which is where a reader stops reading.
    # The range is a contract with the block above: move a subcommand and this
    # prints a usage that does not list it, which is the failure it is for. It
    # was wrong by one line when this was written (3,13p, which printed a blank
    # line and cut off `down`) and is asserted by the sibling tier's checks. The
    # range moved from 4,11p to 4,12p with the `verify-sibling-images` line, which
    # is the same kind of edit: a subcommand added without moving the range is a
    # subcommand this usage does not list.
    sed -n '4,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
