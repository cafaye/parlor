# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# NOTE: next-env.d.ts is deliberately NOT ignored — Next.js docs say to commit
# it, and committing it keeps `npm run typecheck` honest on a fresh clone
# (before anyone has run next dev/build to regenerate it).

# test + tooling output
# (/coverage already listed above)
/test-results
/playwright-report
